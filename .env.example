# Server Port (automatically set by Render/Railway)
PORT=3000

# Environment
NODE_ENV=production

# Local persistent database path (optional, defaults to ./local-data/notes-to-action-db)
# On Render / Railway with persistent disk mounted at /var/data:
# LOCAL_DB_PATH=/var/data/notes-to-action-db

# Optional Remote PostgreSQL Database URL (if set, uses remote Postgres instead of local embedded DB)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional OpenAI API Key (if omitted, automatically falls back to local deterministic extractor)
# OPENAI_API_KEY=sk-...
